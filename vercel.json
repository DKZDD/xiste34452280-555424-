{
  "framework": "nextjs",
  "regions": ["gru1"],
  "git": {
    "deploymentEnabled": { "main": true }
  },
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/events",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(DuckeScripts|entrar|criar-conta)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
